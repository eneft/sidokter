# Environment configuration
PORT=3000

# Trusted authentication service (defaults to internal /api/auth)
VITE_AUTH_API_URL=/api/auth
AUTH_API_URL=/api/auth
FIREBASE_PROJECT_ID=gen-lang-client-0880840770
# Exact browser origin(s) allowed to call the auth/PDF functions
AUTH_ALLOWED_ORIGIN=http://localhost:3000
# For multiple production origins, use comma-separated AUTH_ALLOWED_ORIGINS

# One-time initial Administrator provisioning secret.
# REQUIRED for first Admin setup; generate a strong random value and keep it server-side.
SIDOKTER_BOOTSTRAP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
