# SIDOKTER environment
PORT=3000

# Optional override. Leave empty in production to use the Firebase Function default.
VITE_AUTH_API_URL=
VITE_PDF_API_URL=
AUTH_API_URL=/api/auth
SIDOKTER_PDF_API_URL=

# Firebase project used by the browser/functions.
FIREBASE_PROJECT_ID=gen-lang-client-0880840770

# Browser origins allowed by Firebase Functions. Comma-separated for multiple origins.
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# No bootstrap secret is required. The first Administrator is created once from the login page.
