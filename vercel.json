{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/pdf.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**,public/**,functions/assets/**,functions/fonts/**"
    },
    "api/auth.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/health.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    },
    {
      "source": "/api/hierarchy/:path*",
      "destination": "https://asia-southeast2-sidokter-soegiri.cloudfunctions.net/hierarchyApi/:path*"
    },
    {
      "source": "/api/hierarchy",
      "destination": "https://asia-southeast2-sidokter-soegiri.cloudfunctions.net/hierarchyApi"
    },
    {
      "source": "/api/storage/:path*",
      "destination": "https://asia-southeast2-sidokter-soegiri.cloudfunctions.net/storageApi/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
