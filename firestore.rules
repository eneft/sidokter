rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'gelapgulita3@gmail.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isOwnNotification(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /{document=**} { allow read, write: if false; }
    match /test/{docId} { allow read: if signedIn(); allow write: if false; }

    match /sops/{sopId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status != 'DIARSIPKAN');
      allow create: if isAdmin() || (signedIn() && request.resource.data.status == 'DRAFT' && (!('everActivated' in request.resource.data) || request.resource.data.everActivated != true));
      allow update: if (
        isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewState', 'reviewHistory', 'currentReviewRequesterUid', 'reviewUpdatedAt']) &&
        !(resource.data.status == 'DRAFT' && request.resource.data.status == 'AKTIF' && (resource.data.reviewState == 'REVISION_REQUESTED' || resource.data.reviewState == 'REVISION_SUBMITTED'))
      ) || (
        signedIn() && resource.data.status == 'DRAFT' && request.resource.data.status == 'DRAFT' &&
        request.auth.uid in resource.data.authorizedUids &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id','status','sopNumber','sequenceNumber','revisionNumber','version','jenis_spo','documentType','isReviewDocument','existingSopId','previousRevisionNumber','oldSopNumber','reviewState','reviewHistory','currentReviewRequesterUid','reviewUpdatedAt','authorizedUids','accessKeys','creatorUid','createdBy','everActivated','activatedAt','archivedAt'
        ])
      );
      allow delete: if (
        isAdmin() || (
          signedIn() &&
          (
            (resource.data.keys().hasAny(['creatorUid']) && resource.data.creatorUid == request.auth.uid) ||
            (
              request.auth.token.username != null &&
              resource.data.keys().hasAny(['createdBy']) &&
              resource.data.createdBy == request.auth.token.username
            )
          )
        )
      ) && resource.data.status == 'DRAFT' && (!('everActivated' in resource.data) || resource.data.everActivated != true);
    }

    match /library_documents/{documentId} { allow read, write: if signedIn(); }
    match /system_config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /users/{userId} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /admins/{adminId} { allow read: if isAdmin(); allow create, update, delete: if isAdmin(); }

    // Pesan/notifikasi dibuat oleh trusted backend. Client hanya boleh mengubah
    // state presentasi mailbox miliknya sendiri: read/unread dan soft-delete.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if isOwnNotification(uid);
      allow create: if false;
      allow update: if isOwnNotification(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read', 'readAt', 'hidden', 'deletedAt'
        ]);
      allow delete: if false;
    }

    match /sop_number_reservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.status == 'RESERVED' && request.resource.data.sequenceNumber is int && request.resource.data.sequenceNumber > 0;
      allow update: if signedIn() && resource.data.status == 'RESERVED' && request.resource.data.status == 'USED' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedDocumentId', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
