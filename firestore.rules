    match /sops/{sopId} {
      allow read: if signedIn();
      allow create: if signedIn();

      // A stale editor is rejected using the currently stored status.
      // Only the actual Admin role may update approved/archived documents.
      // Non-Admin users may only update an authorized DRAFT and may not
      // mutate protected document identity, lifecycle, or access-control fields.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        request.auth.uid in resource.data.authorizedUids &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'status',
          'sopNumber',
          'sequenceNumber',
          'revisionNumber',
          'version',
          'jenis_spo',
          'documentType',
          'isReviewDocument',
          'existingSopId',
          'previousRevisionNumber',
          'oldSopNumber',
          'authorizedUids',
          'accessKeys'
        ])
      );

      allow delete: if isAdmin();
    }