    match /sops/{sopId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status != 'DIARSIPKAN');
      allow create: if isAdmin() || (signedIn() && request.resource.data.status == 'DRAFT' && (!('everActivated' in request.resource.data) || request.resource.data.everActivated != true));

      // A stale editor is rejected using the currently stored status.
      // Only the actual Admin role may update approved/archived documents.
      // Non-Admin users may only update an authorized DRAFT and may not
      // mutate protected document identity, lifecycle, or access-control fields.
      allow update: if (
        isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reviewState', 'reviewHistory', 'currentReviewRequesterUid', 'reviewUpdatedAt'
        ]) &&
        !(resource.data.status == 'DRAFT' && request.resource.data.status == 'AKTIF' &&
          (resource.data.reviewState == 'REVISION_REQUESTED' || resource.data.reviewState == 'REVISION_SUBMITTED'))
      ) || (
        signedIn() &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        request.auth.uid in resource.data.authorizedUids &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'status',
          'sopNumber',
          'sequenceNumber',
          'revisionNumber',
          'version',
          'jenis_spo',
          'documentType',
          'isReviewDocument',
          'existingSopId',
          'previousRevisionNumber',
          'oldSopNumber',
          'reviewState',
          'reviewHistory',
          'currentReviewRequesterUid',
          'reviewUpdatedAt',
          'authorizedUids',
          'accessKeys',
          'everActivated',
          'activatedAt',
          'archivedAt'
        ])
      );

      allow delete: if isAdmin() && resource.data.status == 'DRAFT' && resource.data.everActivated != true;
    }


    match /sop_number_reservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status == 'RESERVED'
        && request.resource.data.sequenceNumber is int
        && request.resource.data.sequenceNumber > 0;
      allow update: if signedIn()
        && resource.data.status == 'RESERVED'
        && request.resource.data.status == 'USED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedAt', 'usedDocumentId', 'updatedAt'
        ]);
      allow delete: if isAdmin();
    }
