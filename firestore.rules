rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    match /sops/{sopId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /library_documents/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    // Credentials are server-only. The browser must never read or write them.
    match /user_credentials/{userId} {
      allow read, write: if false;
    }

    // Sessions are server-authoritative. The browser must never read or write them.
    match /session_states/{userId} {
      allow read, write: if false;
      match /sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    match /system_config/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Operational audit logs are not trusted when written directly by a browser.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Authentication audit logs are server-only.
    match /auth_logs/{logId} {
      allow read, write: if false;
    }
  }
}
