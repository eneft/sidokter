rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'gelapgulita3@gmail.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    // Health / Connection check path
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // SOP (Standar Prosedur Operasional) collection
    match /sops/{sopId} {
      // All users and hospital staff can read published & scoped SOPs
      allow read: if true;

      // Only administrators or signed-in users creating draft SOPs
      allow create: if isAdmin() || (signedIn() && request.resource.data.status == 'DRAFT');
      allow update: if isAdmin() || (signedIn() && resource.data.status == 'DRAFT');
      allow delete: if isAdmin();
    }

    // Library documents (SK & MOU regulations)
    match /library_documents/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // System configuration (numbering, maintenance mode)
    match /system_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users directory
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Administrator registry
    match /admins/{adminId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Private user notifications
    match /notifications/{userId}/items/{eventKey} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    // Audit logs: clients may append operational logs, but cannot tamper with or delete logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}

