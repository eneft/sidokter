    match /sops/{sopId} {
      allow read: if signedIn() && (isAdmin() || resource.data.status != 'DIARSIPKAN');
      allow create: if signedIn();

      // A stale editor is rejected using the currently stored status.
      // Only the actual Admin role may update approved/archived documents.
      // Non-Admin users may only update an authorized DRAFT and may not
      // mutate protected document identity, lifecycle, or access-control fields.
      allow update: if (
        isAdmin() &&
        // Once a number has been official it can never return to a recyclable state.
        !(resource.data.get('everActivated', false) == true && request.resource.data.get('everActivated', false) != true) &&
        !((resource.data.status == 'AKTIF' || resource.data.status == 'DIARSIPKAN') && request.resource.data.get('everActivated', false) != true) &&
        !((request.resource.data.status == 'AKTIF' || request.resource.data.status == 'DIARSIPKAN') && request.resource.data.get('everActivated', false) != true) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reviewState', 'reviewHistory', 'currentReviewRequesterUid', 'reviewUpdatedAt'
        ]) &&
        !(resource.data.status == 'DRAFT' && request.resource.data.status == 'AKTIF' &&
          (resource.data.reviewState == 'REVISION_REQUESTED' || resource.data.reviewState == 'REVISION_SUBMITTED'))
      ) || (
        signedIn() &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        request.auth.uid in resource.data.authorizedUids &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'status',
          'sopNumber',
          'sequenceNumber',
          'revisionNumber',
          'version',
          'jenis_spo',
          'documentType',
          'isReviewDocument',
          'existingSopId',
          'previousRevisionNumber',
          'oldSopNumber',
          'reviewState',
          'reviewHistory',
          'currentReviewRequesterUid',
          'reviewUpdatedAt',
          'authorizedUids',
          'accessKeys'
        ])
      );

      allow delete: if isAdmin() && resource.data.status == 'DRAFT' && resource.data.get('everActivated', false) == false;
    }
