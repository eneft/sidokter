rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global fallback: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'gelapgulita3@gmail.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function hasSopReadAccess() {
      return signedIn() && resource.data.authorizedUids != null && request.auth.uid in resource.data.authorizedUids;
    }

    function isValidSop() {
      return request.resource.data.title is string &&
             request.resource.data.title.size() > 0;
    }

    function isValidLibraryDoc() {
      return request.resource.data.title is string &&
             request.resource.data.title.size() > 0;
    }

    // Health / Connection check path
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // SOP (Standar Prosedur Operasional) collection
    match /sops/{sopId} {
      // Read & write access enabled for SIDOKTER application operations
      allow read, write: if true;
    }

    // Library documents (SK & MOU regulations)
    match /library_documents/{documentId} {
      allow read, write: if true;
    }

    // System configuration (numbering, maintenance mode)
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Users directory
    match /users/{userId} {
      allow read, write: if true;
    }

    // Administrator registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Private user notifications
    match /notifications/{document=**} {
      allow read, write: if true;
    }

    // Number reservations collection
    match /sop_number_reservations/{reservationId} {
      allow read, write: if true;
    }

    // Audit logs: clients may append operational logs and read logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}

