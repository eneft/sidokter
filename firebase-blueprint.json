{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firestore-blueprint.json",
  "collections": {
    "sops": {
      "description": "Koleksi dokumen Standar Prosedur Operasional (SPO) RSUD Dr. Soegiri Lamongan",
      "fields": {
        "id": { "type": "string", "description": "ID unik SPO", "required": true },
        "title": { "type": "string", "description": "Judul SPO", "required": true },
        "sopNumber": { "type": "string", "description": "Nomor SPO resmi", "required": false },
        "jenis_spo": { "type": "string", "description": "Jenis SPO (BARU, RIVIU, EKSISTING)", "required": false },
        "status": { "type": "string", "description": "Status SPO (DRAFT, AKTIF, KEDALUWARSA, DICABUT)", "required": true },
        "divisionCode": { "type": "string", "description": "Kode divisi/bidang/unit kerja utama", "required": false },
        "divisionCodes": { "type": "array", "description": "Daftar kode divisi berhak akses", "required": false },
        "unitName": { "type": "string", "description": "Nama unit/bidang penerbit", "required": false },
        "content": { "type": "map", "description": "Batang tubuh SPO (pengertian, tujuan, kebijakan, prosedur, dll)", "required": false },
        "createdAt": { "type": "string", "description": "Waktu pembuatan ISO 8601", "required": true },
        "updatedAt": { "type": "string", "description": "Waktu perubahan terakhir ISO 8601", "required": true },
        "activatedAt": { "type": "string", "description": "Waktu aktivasi/pengesahan", "required": false },
        "activatedBy": { "type": "string", "description": "Nama petugas/admin pengesah", "required": false },
        "activationNotes": { "type": "string", "description": "Catatan pengesahan Direktur", "required": false }
      },
      "rules": "authenticated read; admin create/update/delete"
    },
    "library_documents": {
      "description": "Koleksi dokumen hukum dan regulasi SK (Surat Keputusan) dan MoU (Nota Kesepahaman)",
      "fields": {
        "id": { "type": "string", "description": "ID dokumen library", "required": true },
        "type": { "type": "string", "description": "Jenis dokumen: SK atau MOU", "required": true },
        "title": { "type": "string", "description": "Judul dokumen", "required": true },
        "documentNumber": { "type": "string", "description": "Nomor surat/dokumen", "required": false },
        "partnerName": { "type": "string", "description": "Nama instansi/mitra kerja sama (khusus MoU)", "required": false },
        "status": { "type": "string", "description": "Status dokumen (AKTIF, dll)", "required": true },
        "fileName": { "type": "string", "description": "Nama berkas", "required": false },
        "fileSize": { "type": "number", "description": "Ukuran berkas dalam byte", "required": false },
        "effectiveDate": { "type": "string", "description": "Tanggal berlaku", "required": false },
        "expiryDate": { "type": "string", "description": "Tanggal kedaluwarsa", "required": false },
        "createdAt": { "type": "string", "description": "Waktu pembuatan ISO 8601", "required": true },
        "updatedAt": { "type": "string", "description": "Waktu pembaruan ISO 8601", "required": true },
        "uploadedBy": { "type": "string", "description": "Petugas pengunggah", "required": false }
      },
      "rules": "authenticated read; admin create/update/delete"
    },
    "users": {
      "description": "Koleksi akun pengguna dan administrator tata naskah",
      "fields": {
        "id": { "type": "string", "description": "ID unik pengguna", "required": true },
        "username": { "type": "string", "description": "Username akun", "required": true },
        "name": { "type": "string", "description": "Nama lengkap pengguna", "required": true },
        "role": { "type": "string", "description": "Peran akun (admin atau user)", "required": true },
        "divisionCode": { "type": "string", "description": "Kode divisi utama", "required": false },
        "divisionCodes": { "type": "array", "description": "Daftar kode divisi berhak", "required": false },
        "badges": { "type": "array", "description": "Lencana akses khusus (e.g. STRUKTURAL)", "required": false },
        "updatedAt": { "type": "string", "description": "Waktu update terakhir", "required": false }
      },
      "rules": "self/admin read; admin write"
    },
    "system_config": {
      "description": "Konfigurasi sistem tata naskah termasuk penomoran dan mode pemeliharaan",
      "fields": {
        "id": { "type": "string", "description": "ID konfigurasi (e.g. numbering, maintenance)", "required": true },
        "value": { "type": "map", "description": "Nilai konfigurasi", "required": true },
        "updatedAt": { "type": "string", "description": "Waktu perubahan", "required": true }
      },
      "rules": "authenticated read; admin create/update/delete"
    },
    "audit_logs": {
      "description": "Catatan riwayat aktivitas operasional tata naskah",
      "fields": {
        "id": { "type": "string", "description": "ID log", "required": true },
        "action": { "type": "string", "description": "Nama tindakan aktivitas", "required": true },
        "actorName": { "type": "string", "description": "Nama pelaku tindakan", "required": false },
        "actorRole": { "type": "string", "description": "Role pelaku", "required": false },
        "details": { "type": "string", "description": "Detail log", "required": false },
        "timestamp": { "type": "string", "description": "Waktu kejadian ISO 8601", "required": true }
      },
      "rules": "admin read; backend write only"
    }
  },
  "indexes": []
}
